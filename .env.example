# ============================================
# GAV - The Incense Route | Environment Variables
# ============================================

# Pi Network API Key (from develop.pinet.com - GAV app ONLY)
PI_API_KEY=

# Environment: development | testnet | mainnet
NODE_ENV=testnet

# Pi API Base URL (do not change unless Pi updates)
PI_API_BASE=https://api.minepi.com

# Database URL (PostgreSQL)
DATABASE_URL=

# CORS allowed origins (comma separated)
CORS_ORIGINS=https://gav-the-incense-route.vercel.app

# Rate limiting (requests per 15 minutes)
RATE_LIMIT_MAX=100

# Server port (for local dev)
PORT=3000