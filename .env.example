# ============================================
# GAV - The Incense Route | Environment Variables
# Mainnet configuration
# ============================================

# Pi Network API Key — Mainnet app only (from develop.pinet.com)
# NEVER commit the real value.
PI_API_KEY=

# Environment: development | mainnet
NODE_ENV=mainnet

# Pi API Base URL (do not change)
PI_API_BASE=https://api.minepi.com

# Database URL (PostgreSQL)
DATABASE_URL=

# CORS allowed origins (comma separated)
CORS_ORIGINS=https://gav-the-incense-route.vercel.app

# Rate limiting (requests per 15 minutes)
RATE_LIMIT_MAX=100

# Server port (local dev only)
PORT=3000