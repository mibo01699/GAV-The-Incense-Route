{
  "name": "gav-the-incense-route",
  "version": "1.0.0",
  "description": "GAV – The Incense Route | Pi Network marketplace on Testnet",
  "main": "api/v1/index.js",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "NODE_ENV=development node index.js",
    "test": "jest",
    "test:api": "jest tests/api",
    "test:client": "jest tests/client",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --runInBand --verbose"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/public/"
    ],
    "collectCoverageFrom": [
      "api/**/*.js",
      "index.js",
      "!api/_lib/**",
      "!**/node_modules/**",
      "!**/tests/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "verbose": true,
    "clearMocks": true,
    "resetModules": false,
    "testTimeout": 15000
  }
}