{
  "version": 2,
  "builds": [
    {
      "src": "api/auth/verify.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/v1/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/auth/verify",
      "dest": "/api/auth/verify.js"
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/v1/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/v1/index.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
